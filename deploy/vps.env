# Frontend build/runtime settings
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
VITE_BACKEND_API_URL="/api"
WEB_HOST_PORT="8080"

# Supabase core credentials used by backend services
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# External Supabase access used by admin-proxy
EXTERNAL_SUPABASE_URL="https://your-project-ref.supabase.co"
EXTERNAL_SUPABASE_SERVICE_KEY="your-external-service-key"

# External proxy exposed on the VPS
INTERNAL_PROXY_KEY="change-me"
ALLOWED_ORIGINS="https://your-production-domain.com"
APP_ORIGIN="https://your-production-domain.com"
ALLOWED_PROXY_HOSTS="https://app.registrobase.com.br:32077"
DELPHI_PROXY_URL="http://delphi-proxy:8787/external-db-proxy"

# Delphi upstream
DELPHI_API_URL="https://app.registrobase.com.br:32077/api/listarfromselect"
DELPHI_API_TOKEN="your-delphi-api-token"
DELPHI_AUTH_URL="https://app.registrobase.com.br:32077/auth?tokenapi=your-tokenapi"
DELPHI_AUTH_TOKENAPI="your-tokenapi"
DELPHI_AUTH_BEARER="your-fallback-bearer"
DELPHI_AUTH_TIMEOUT_MS="4500"
DELPHI_AUTH_CACHE_MAX_AGE_SEC="300"

# Optional app settings
RATE_LIMIT_WINDOW_SEC="60"
RATE_LIMIT_MAX_REQ="60"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
MAX_ROWS="5000"
LOG_LEVEL="INFO"
APP_TIMEZONE="America/Sao_Paulo"
INDEX_CHART_NORMALIZATION_FALLBACK=""
GEMINI_API_KEY="your-gemini-api-key"
PYTHON_API_URL="http://chart-processor:8000"
# Chat-proxy and chart-processor must share the same internal token value.
INTERNAL_API_TOKEN="your-internal-api-token"
PYTHON_INTERNAL_API_TOKEN=""
