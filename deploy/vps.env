# Frontend build/runtime settings
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
VITE_BACKEND_API_URL="/api"

# External proxy exposed on the VPS
INTERNAL_PROXY_KEY="change-me"
ALLOWED_ORIGINS="https://your-production-domain.com"
APP_ORIGIN="https://your-production-domain.com"
ALLOWED_PROXY_HOSTS="https://app.registrobase.com.br:32077"
DELPHI_PROXY_URL="https://your-production-domain.com/api/external-db-proxy"

# Delphi upstream
DELPHI_API_URL="https://app.registrobase.com.br:32077/api/listarfromselect"
DELPHI_API_TOKEN="your-delphi-api-token"
DELPHI_AUTH_URL="https://app.registrobase.com.br:32077/auth?tokenapi=your-tokenapi"
DELPHI_AUTH_TOKENAPI="your-tokenapi"
DELPHI_AUTH_BEARER="your-fallback-bearer"
DELPHI_AUTH_TIMEOUT_MS="4500"
DELPHI_AUTH_CACHE_MAX_AGE_SEC="300"

# Optional app settings
RATE_LIMIT_WINDOW_SEC="60"
RATE_LIMIT_MAX_REQ="60"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
MAX_ROWS="5000"
LOG_LEVEL="INFO"
PYTHON_INTERNAL_API_TOKEN=""
